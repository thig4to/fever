set shell := ["powershell.exe", "-c"]

BUILD_DIR := "build"
EXE_NAME := "engine"

# Exibe os comandos disponíveis
default:
    just --list

# Inicializa o projeto
setup:
    meson setup --reconfigure --backend ninja {{BUILD_DIR}} .

# Compila o projeto
build:
    meson compile -C {{BUILD_DIR}}

# Compila o projeto e executa o cliente
run: build
    ./{{BUILD_DIR}}/{{EXE_NAME}}
